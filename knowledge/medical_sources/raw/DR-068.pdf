1 0 0 1 102.0 741.2 Tm
0.0000 Tw
(                    CPT Code  "MLH-1, Immunostain" - 88342/\(if appropriate\)<br /> ) Tj
1 0 0 1 102.0 731.6 Tm
0.0000 Tw
(                              "MSH-2, Immunostain" - 88342/\(if appropriate\)<br /> ) Tj
1 0 0 1 102.0 722.0 Tm
