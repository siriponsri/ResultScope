0.0000 Tw
(                              <td width="110" valign="top" align="center">Red top tube</td> ) Tj
1 0 0 1 102.0 342.8 Tm
0.0000 Tw
(                              <td width="110" valign="top" align="center">Red top tube</td> ) Tj
1 0 0 1 102.0 333.2 Tm
0.0000 Tw
