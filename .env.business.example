# Copy these entries into your existing .env; do not overwrite existing keys or budget cycles.
# Empty DATABASE_URL uses encrypted local SQLite. Hosted runtimes REQUIRE PostgreSQL.
DATABASE_URL=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Preserve this key forever with encrypted records. Never rotate without re-encryption.
BUSINESS_DATA_KEY=
BUSINESS_PUBLIC_URL=https://your-project.vercel.app
BUSINESS_EXTERNAL_ENABLED=false
BUSINESS_WORKER_ENABLED=false
BUSINESS_WORKER_SECRET=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ALLOW_PUSH=false
# ONLY test keys. Live payment is intentionally disabled for coursework.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_EMBED_KEY=
# Set VISION_ENABLED=true in the main .env for either OCR provider.
# typhoon (existing configured vision provider) or iapp
REPORT_OCR_PROVIDER=typhoon
IAPP_OCR_API_KEY=
IAPP_OCR_MODE=text
# Conversation model example; default is Typhoon. iApp candidate is separate from NECTEC OpenThaiLLM.
# LLM_BASE_URL=https://api.iapp.co.th/v3/llm/openthai2p0
# LLM_MODEL=openthai2.0
# Configure provider network access and a bounded provider-budget cycle in the existing .env.
