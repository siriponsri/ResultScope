# ResultScope 3.0 — server-side configuration. Never commit a filled .env.
APP_NAME=ResultScope Laboratory Assistant
APP_ENV=development
OWNER_NAME=Your Name
CORS_ALLOWED_ORIGINS=

# LLM conversation (JSON-capable, OpenAI-compatible endpoint).
LLM_BASE_URL=https://api.opentyphoon.ai/v1
LLM_API_KEY=
LLM_MODEL=typhoon-v2.5-30b-a3b-instruct
LLM_TIMEOUT_SECONDS=60

# Independent Llama Guard. Or use GUARD_SERVICE_URL for teacher-compatible /check.
GUARD_BASE_URL=https://openrouter.ai/api/v1
GUARD_API_KEY=
GUARD_MODEL=meta-llama/llama-guard-4-12b
GUARD_TIMEOUT_SECONDS=20
GUARD_SERVICE_URL=
GUARD_SERVICE_TOKEN=

# Optional report pixels -> transcription -> user-confirmed fields.
VISION_ENABLED=false
VISION_BASE_URL=https://api.opentyphoon.ai/v1
VISION_API_KEY=
VISION_MODEL=typhoon-ocr
VISION_TIMEOUT_SECONDS=60

# Conversation context. Cloud live mode requires secret >=32 and access code >=12 chars.
SESSION_SIGNING_KEY=
CONTEXT_TTL_SECONDS=3600
DEMO_ACCESS_CODE=

# Calls default OFF. Set a deliberate cycle/cap before enabling.
# Local: run python scripts/provider_budget_cycle.py create after editing these.
PROVIDER_NETWORK_ENABLED=false
PROVIDER_BUDGET_PATH=data/provider_budget.sqlite3
PROVIDER_BUDGET_CYCLE_ID=
PROVIDER_BUDGET_LLM_LIMIT=100
PROVIDER_BUDGET_OCR_LIMIT=10
PROVIDER_BUDGET_SYSTEMONE_LIMIT=0
# Cloud: one persistent atomic Redis counter; failed attempts count too.
CLOUD_CALL_LIMIT=200
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional external semantic/graph retrieval. BM25 works without these.
LIGHTRAG_ENABLED=false
LIGHTRAG_URL=
LIGHTRAG_API_KEY=
RETRIEVAL_TIMEOUT_SECONDS=12

# Retained local v1/admin settings; not the v2 conversation controller.
LOCAL_DEMO_MODE=false
ADMIN_PASSWORD_HASH=
ADMIN_SETTINGS_PATH=data/admin_settings.json
ADMIN_SECRET_STORAGE_KEY=
SYSTEMONE_SHADOW_ENABLED=false
STORAGE_BACKEND=auto
SQLITE_PATH=data/resultscope.db
SESSION_TTL_SECONDS=86400
KNOWLEDGE_MODE=release
PUBLIC_REFERENCE_ENABLED=false
PUBLIC_REFERENCE_ROOT=vendor/resultscope_evidence_v1

# Business storage and integrations: merge .env.business.example before hosting.
