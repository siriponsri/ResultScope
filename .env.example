# ---------- Product ----------
APP_NAME=ResultScope
APP_TAGLINE=Laboratory results, in context.
OWNER_NAME=Your Name
APP_ENV=development
CORS_ALLOWED_ORIGINS=

# ---------- Typhoon LLM (OpenAI-compatible) ----------
LLM_BASE_URL=https://api.opentyphoon.ai/v1
LLM_API_KEY=replace_me
LLM_MODEL=typhoon-v2.5-30b-a3b-instruct
# SYSTEM_PROMPT=Optional override. Usually leave unset to use the product prompt in config.py.

# ---------- Typhoon OCR ----------
# Disabled by default until an owner-supplied key is configured server-side.
VISION_ENABLED=false
VISION_BASE_URL=https://api.opentyphoon.ai/v1
VISION_API_KEY=
VISION_MODEL=typhoon-ocr
VISION_TIMEOUT_SECONDS=60

# ---------- Admin Settings (explicit local demo only) ----------
LOCAL_DEMO_MODE=false
ADMIN_PASSWORD_HASH=
ADMIN_SETTINGS_PATH=data/admin_settings.json
ADMIN_SECRET_STORAGE_KEY=
SYSTEMONE_SHADOW_ENABLED=true

# ---------- Session storage ----------
# auto: Upstash if configured; SQLite locally; memory on Vercel when no external store exists.
STORAGE_BACKEND=auto
SQLITE_PATH=data/resultscope.db
SESSION_TTL_SECONDS=86400

# Optional, recommended for persistent Vercel sessions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
