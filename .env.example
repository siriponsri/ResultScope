# ---------- Product ----------
APP_NAME=ResultScope
APP_TAGLINE=Laboratory results, in context.
OWNER_NAME=Your Name
APP_ENV=development
CORS_ALLOWED_ORIGINS=

# ---------- OpenAI-compatible LLM ----------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace_me
LLM_MODEL=openai/gpt-4o-mini
# SYSTEM_PROMPT=Optional override. Usually leave unset to use the product prompt in config.py.

# ---------- Optional Vision/OCR provider ----------
# Disabled by default. Enable only with an image-capable OpenAI-compatible model.
VISION_ENABLED=false
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=60

# ---------- Session storage ----------
# auto: Upstash if configured; SQLite locally; memory on Vercel when no external store exists.
STORAGE_BACKEND=auto
SQLITE_PATH=data/resultscope.db
SESSION_TTL_SECONDS=86400

# Optional, recommended for persistent Vercel sessions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
